# Copy to .env. Never commit .env.
# mock = no network calls, no keys needed (default). live = real OutLayer wallets and 1Click.
CARRY_MODE=mock
CARRY_HANDLE=demo
PORT=8787            # home app (loopback only)
HOST=127.0.0.1
PUBLIC_PORT=8788     # pay page + phone API
PUBLIC_HOST=127.0.0.1
CARRY_DB=data/carry.db

# Live mode only. These stay on the home side, never on the phone.
OUTLAYER_BASE=https://api.outlayer.ai
RESERVE_KEY=
RESERVE_ACCOUNT=
POCKET_KEY=              # read-only use by the service (to read the pocket balance)
POCKET_ACCOUNT=
ONECLICK_API_KEY=
PROD_APPROVER_ACCOUNT=
PROD_APPROVER_PUBKEY=
PROD_APPROVER_SEED=
