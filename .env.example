# Copy to .env. Never commit .env.
# mock = no network calls, no keys needed (default). live = real OutLayer wallets and 1Click.
CARRY_MODE=mock
CARRY_HANDLE=demo
PORT=8787            # the app: pay page, phone API, signed home routes
HOST=127.0.0.1
CARRY_DB=data/carry.db
CARRY_TICK_MS=5000         # how often the service checks for new payments and refills (default 5000)
CARRY_TOPUP_MS=300000      # how often it tops the pocket up on a timer (default 300000 = 5 minutes)

# Live mode only. These stay on the home side, never on the phone.
OUTLAYER_BASE=https://api.outlayer.ai
RESERVE_KEY=
RESERVE_ACCOUNT=
POCKET_KEY=              # read-only use by the service (to read the pocket balance)
POCKET_ACCOUNT=
ONECLICK_API_KEY=
PROD_APPROVER_ACCOUNT=
PROD_APPROVER_PUBKEY=
PROD_APPROVER_SEED=
CARRY_PUBLIC_URL=      # base URL used in the pairing QR, e.g. https://carry.example.com (defaults to the browser origin)
CARRY_EXIT_ACCOUNT=nearhacka.near
# Mock/demo only (live mode always starts the refill allowance at 0):
CARRY_DEMO_ALLOWANCE_USDC=3   # a fresh demo database starts with this refill allowance (default 3, so the first 5 USDC payment splits 3 / 2)
# The pocket's two limits, shown on the phone. Mirror the locked pocket policy (live: OutLayer enforces the real policy):
CARRY_PHONE_CEILING_USDC=20   # the pocket holds at most this much (default 20)
CARRY_PHONE_TX_USDC=10        # the phone can send at most this much per transaction (default 10)
