# /etc/caddy/Caddyfile on the VPS. Caddy gets and renews the HTTPS certificate by itself (the DNS A record must point here).
carry.ajkadri.dev {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8797
}

# The public sandbox (mock mode, one world per visitor). Separate service on its own loopback port; see deploy/carry-demo.service.
demo.carry.ajkadri.dev {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8798
}
