{
  "name": "carry",
  "version": "0.1.0",
  "description": "Get paid from another chain (USDC on Solana, Base, Arbitrum or Ethereum, USDT on Tron). Your phone only carries a small amount; the rest sits in a reserve the phone cannot reach.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "demo": "node scripts/demo.js",
    "start": "node server/index.js",
    "dev": "node scripts/dev.js",
    "build": "npm run build -w web",
    "test": "node --test test/*.test.js",
    "attack": "node scripts/attack.js",
    "reset-home-key": "node scripts/reset-home-key.js",
    "contrast": "node scripts/contrast.js",
    "quote-check": "node scripts/quote-check.js",
    "test:sandbox": "CARRY_TEST_SANDBOX=1 node --test test/*.test.js",
    "sandbox": "CARRY_MODE=mock node server/sandbox-main.js",
    "attack:sandbox": "node scripts/attack.js --sandbox"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
